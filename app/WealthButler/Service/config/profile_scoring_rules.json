        "risk_level": "中"
      },
      "dispersed_withdrawal": {
        "name": "分散转出",
        "threshold": "单日出金至5个以上不同银行账户",
        "risk_level": "高"
      },
      "product_risk_exceed": {
        "name": "产品风险越级",
        "threshold": "要求购买超过风险等级2级以上的产品",
        "risk_level": "高"
      },
      "frequent_info_change": {
        "name": "信息频繁变更",
        "threshold": "30天内变更手机/地址≥3次",
        "risk_level": "中"
      },
      "proxy_operation": {
        "name": "代理操作",
        "threshold": "频繁由同一非本人设备/IP操作",
        "risk_level": "高"
      }
    },
    "scoring_rules": [
      {"abnormal_count_description": "无异常", "score": 20},
      {"abnormal_count_description": "1-2项低风险异常", "score": 15},
      {"abnormal_count_description": "1-2项中风险异常", "score": 10},
      {"abnormal_count_description": "3项以上中风险异常", "score": 5},
      {"abnormal_count_description": "任何高风险异常", "score": 0}
    ],
    "calculation": "维度四得分 = 异常行为计分 (满分20分)"
  },
  "综合评分公式": "综合得分 = 维度一得分 × 25% + 维度二得分 × 25% + 维度三得分 × 30% + 维度四得分 × 20%",
