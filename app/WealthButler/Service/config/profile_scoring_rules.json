  "dimension4": {
    "name": "行为异常特征",
    "weight": 0.2,
    "max_score": 20,
    "abnormal_behaviors": {
      "frequent_redemption": {
        "name": "频繁赎回",
        "threshold": "30天内赎回次数≥5次",
