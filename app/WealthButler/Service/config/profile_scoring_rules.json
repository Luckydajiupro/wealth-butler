      },
      "abnormal_time_transaction": {
        "name": "非正常时段交易",
        "threshold": "凌晨0:00-6:00频繁登录/交易",
        "risk_level": "低"
      },
      "sudden_large_deposit": {
        "name": "突然大额入金",
