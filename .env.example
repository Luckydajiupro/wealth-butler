# ============================================================
# 智能财富管家系统 环境变量模板（.env.example）
#
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env（Windows 下直接复制改名）
#   2. 在 .env 中填入团队共享/各自本机的真实值（API Key、密码等）
#   3. .env 已在 .gitignore 中忽略，不会提交；本模板随仓库共享
#
# 变量名依据：app/Config/setting.py（各模块的 env_prefix 与 alias）
# 默认值对齐 Docker 容器本地部署的端口约定
# ============================================================

# ---------- 日志级别 ----------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- HTTP 通用（httpUtils 超时，秒）----------
HTTP_TIMEOUT=360


# ============================================================
# 核心数据库（项目 5 个 Agent 全部依赖，必须配置）
# ============================================================

# ---------- MySQL（业务数据）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wealth_butler
DB_CHARSET=utf8mb4

# ---------- Redis（事件总线 + 缓存）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- Milvus（向量数据库，客服 RAG 用）----------
# 优先使用 MILVUS_URI 整体指定连接地址；不填则按 HOST/PORT 拼接
MILVUS_URI=http://127.0.0.1:19530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TIMEOUT=10
# 向量维度需与所用嵌入模型输出维度一致（bge-m3 输出 1024 维，与 1024 匹配）
MILVUS_VECTOR_DIM=1024
MILVUS_SECURE=false
MILVUS_ALIAS=default

# ---------- Neo4j（投顾图谱）----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------- MinIO（对象存储：知识库原始文件等）----------
# endpoint 不带协议前缀，如 127.0.0.1:9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=


# ============================================================
# LLM（大模型，必须配置；嵌入向量可走本地 Ollama）
# ============================================================

# ---------- 通义千问（DashScope，对话用）----------
# 注意：代码实际读取的是 QWEN_BASE_URL / QWEN_DEFAULT_MODEL / MY_DASHSCOPE_API_KEY
#       （部分脚手架文档写的是 DASHSCOPE_API_KEY 等旧名，以本文件为准）
MY_DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_DEFAULT_MODEL=qwen-plus

# ---------- Ollama（本地向量模型，客服 RAG 检索用）----------
# 向量模型用本地 Ollama 里的 bge-m3，不走云端、无 API Key
# 注意：脚手架嵌入目前走 Qwen（Ai/llms/qwenLlm.py:_embedding），需在
#       app/Config/setting.py 新增 OllamaSettings（OLLAMA_BASE_URL / OLLAMA_EMBEDDING_MODEL）
#       并由 RAG 嵌入调用处改读本地 Ollama，属李清华 Day1 底座任务
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_EMBEDDING_MODEL=bge-m3

# ---------- DeepSeek（数据分析/研判等）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# ---------- LLM 通用 ----------
# 单次 LLM 调用超时（秒），默认 300
LLM_TIMEOUT=300


# ============================================================
# 认证与安全
# ============================================================

# ---------- JWT ----------
# 建议用一段随机长字符串，如 openssl rand -hex 32 生成
JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
