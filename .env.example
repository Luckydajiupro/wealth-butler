# ============================================================
# 智能财富管家系统 环境变量模板（.env.example）
#
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env（Windows 下直接复制改名）
#   2. 在 .env 中填入团队共享/各自本机的真实值（API Key、密码等）
#   3. .env 已在 .gitignore 中忽略，不会提交；本模板随仓库共享
#
# 变量名依据：app/Base/Config/setting.py（各模块的 env_prefix 与 alias）
# 默认值对齐 Docker 容器本地部署的端口约定
# ============================================================

# ---------- 日志级别 ----------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- HTTP 通用（httpUtils 超时，秒）----------
HTTP_TIMEOUT=360


# ============================================================
# 核心数据库（项目 5 个 Agent 全部依赖，必须配置）
# ============================================================

# ---------- MySQL（业务数据）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wealth_butler
DB_CHARSET=utf8mb4

# ---------- Base Module（调度器任务表，通常与主数据库同库）----------
BASE_DB_NAME=wealth_butler

# ---------- Redis（事件总线 + 缓存）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- Milvus（向量数据库，客服 RAG 用）----------
# 优先使用 MILVUS_URI 整体指定连接地址；不填则按 HOST/PORT 拼接
MILVUS_URI=http://127.0.0.1:19530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 本项目 milvus-standalone 未启用鉴权，可留空；若开启则填 root/Milvus（Dify 默认）或自定义凭据
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TIMEOUT=10
# 向量维度需与所用嵌入模型输出维度一致（bge-m3 输出 1024 维，与 1024 匹配）
MILVUS_VECTOR_DIM=1024
MILVUS_SECURE=false
MILVUS_ALIAS=default

# ---------- Neo4j（投顾图谱）----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------- MinIO（对象存储：知识库原始文件等）----------
# endpoint 不带协议前缀，如 127.0.0.1:9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=


# ============================================================
# LLM（大模型，必须配置；嵌入向量可走本地 Ollama）
# ============================================================

# ---------- 通义千问（DashScope，对话用）----------
# 注意：代码实际读取的是 QWEN_BASE_URL / QWEN_DEFAULT_MODEL / MY_DASHSCOPE_API_KEY
#       （部分脚手架文档写的是 DASHSCOPE_API_KEY 等旧名，以本文件为准）
MY_DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_DEFAULT_MODEL=qwen-plus

# ---------- Ollama（本地向量模型，客服 RAG 检索用）----------
# 向量模型用本地 Ollama 里的 bge-m3，不走云端、无 API Key
# 说明：RAG 嵌入统一调本地 Ollama（封装见 Base/Ai/llms/ollamaEmbedding.py 的 ollama_embedding()），
#       配置定义见 Base/Config/setting.py 的 OllamaSettings，不再走云端 Qwen
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_EMBEDDING_MODEL=bge-m3

# ---------- DeepSeek（数据分析/研判等）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# 仅在 v2 side-by-side 迁移和召回验收通过后设置；留空时仍读旧集合。
WEALTH_BUTLER_MEMORY_COLLECTION=

# ---------- LLM 通用 ----------
# 单次 LLM 调用超时（秒），默认 300
LLM_TIMEOUT=300


# ============================================================
# 认证与安全
# ============================================================

# ---------- WealthButler Web 入口 ----------
# 正式环境建议保持 false；本地调试时可显式改为 true
WEALTH_BUTLER_DEBUG=false
# 逗号分隔。若配置为 *，程序会强制关闭 allow_credentials
WEALTH_BUTLER_CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:5173,http://127.0.0.1:5173
WEALTH_BUTLER_CORS_ALLOW_CREDENTIALS=true
WEALTH_BUTLER_ACCESS_LOG=true
WEALTH_BUTLER_LOG_LEVEL=info

# ---------- 业务操作 Agent 正式 Runtime ----------
# 默认关闭。启用前必须先执行 Operator Schema 迁移，并配置下面三个
# module:attribute 形式的业务读取器。读取器缺失或数据不完整时会拒绝启动，不回退 Fake。
WEALTH_BUTLER_OPERATOR_REAL_ENABLED=false
WEALTH_BUTLER_OPERATOR_COMPLIANCE_EVIDENCE_LOADER=app.WealthButler.Service.operatorComplianceLoaders:compliance_evidence_loader
WEALTH_BUTLER_OPERATOR_HOLDING_SUMMARY_LOADER=app.WealthButler.Service.operatorComplianceLoaders:holding_summary_loader
WEALTH_BUTLER_OPERATOR_PAYEE_VERIFIER=app.WealthButler.Service.operatorComplianceLoaders:payee_verifier
# 独立的收款方指纹密钥（至少32字节），不得与JWT或数据库密码复用。
WEALTH_BUTLER_PAYEE_HMAC_KEY=
# 交易连接和 Redis 确认存储的快速失败超时。
DB_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=5

# ---------- JWT ----------
# 建议用一段随机长字符串，如 openssl rand -hex 32 生成
JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
